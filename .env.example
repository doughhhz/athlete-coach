# Repository-level reference. Expo loads the corresponding values from
# apps/mobile/.env.local (copy apps/mobile/.env.example there).
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Never add a Supabase secret key or legacy service_role key to mobile variables.
